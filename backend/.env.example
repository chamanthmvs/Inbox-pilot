# Copy this file to `.env` (same folder) and fill in values. `.env` is gitignored.
# The backend loads it automatically on startup.

# Enable the LLM classifier (handles whatever the rules don't catch, cheaply and
# batched). Without this key, the app runs rules-only and everything else goes to
# NEEDS_REVIEW — which is why you saw a big review pile.
ANTHROPIC_API_KEY=sk-ant-...

# Model for classification. Default is claude-haiku-5-5 (cheapest, batched).
# CLASSIFIER_MODEL=claude-haiku-5-5

# Preview mode: fetch + classify + propose, but apply NOTHING to Gmail.
# DRY_RUN=1

# Rules only, never call the LLM.
# USE_LLM=0

# AI-vet rules: the AI confirms/corrects every rule match (no rule decides alone).
# On by default. Set to 0 for a faster, rules-first pass.
# VERIFY_RULES=1
